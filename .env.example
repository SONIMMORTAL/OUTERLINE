# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Stripe Payments ---
# Secret or restricted key (Checkout Sessions: Write, PaymentIntents: Read, Products: Write, Prices: Write).
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# Shows "Credit / Debit Card" at checkout. Set to true only once the two values above are set.
NEXT_PUBLIC_STRIPE_ENABLED=false

# --- Twilio SMS Notifications ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+17186007410
ADMIN_PHONE_NUMBER=+17186007410
VENDOR_PHONE_NUMBER=+17186007410

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
# Must use a domain verified in Resend (Domains). Without it, email only reaches the Resend account owner.
RESEND_FROM_EMAIL=Outerline <hello@outerlineusa.com>
ADMIN_EMAIL=1outerline@gmail.com
VENDOR_EMAIL=1outerline@gmail.com

# --- Mailchimp Marketing ---
MAILCHIMP_API_KEY=your_mailchimp_api_key-us16
MAILCHIMP_LIST_ID=your_mailchimp_audience_id
MAILCHIMP_SERVER_PREFIX=us16

# --- Admin Authentication ---
ADMIN_USERNAME=Outer
ADMIN_PASSWORD=Ensink144
